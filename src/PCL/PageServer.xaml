<?xml version="1.0" encoding="utf-8"?>
<local:MyPageRight x:Class="PCL.PageServer" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:PCL" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" RenderOptions.BitmapScalingMode="LowQuality">
	<Grid Margin="25,10,25,10">
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto" />
			<RowDefinition Height="*" />
		</Grid.RowDefinitions>
		<Grid.ColumnDefinitions>
			<ColumnDefinition Width="*" />
		</Grid.ColumnDefinitions>
		<local:MyCard Grid.Row="0" Margin="0,15,0,10" Title="服务器实例">
			<Grid Margin="21,40,21,16">
				<Grid.RowDefinitions>
					<RowDefinition Height="34" />
					<RowDefinition Height="Auto" />
					<RowDefinition Height="Auto" />
				</Grid.RowDefinitions>
				<Grid.ColumnDefinitions>
					<ColumnDefinition Width="Auto" />
					<ColumnDefinition Width="*" />
					<ColumnDefinition Width="Auto" />
					<ColumnDefinition Width="Auto" />
					<ColumnDefinition Width="Auto" />
				</Grid.ColumnDefinitions>
				<TextBlock Text="实例" VerticalAlignment="Center" Margin="0,0,12,0" />
				<local:MyComboBox x:Name="ComboServers" Grid.Column="1" VerticalAlignment="Center" SelectionChanged="ComboServers_SelectionChanged" ToolTip="选择一个服务器实例。每个实例拥有独立的 server.jar、mods、plugins、world 与配置。" />
				<local:MyButton x:Name="BtnServerNew" Grid.Column="2" Text="新建" Height="34" Margin="10,0,0,0" Click="BtnServerNew_Click" ToolTip="创建一个新的服务器实例，并下载对应的服务端核心"  Padding="13,0" />
				<local:MyButton x:Name="BtnServerDelete" Grid.Column="3" Text="删除" Height="34" Margin="8,0,0,0" Click="BtnServerDelete_Click" ToolTip="删除当前选中的服务器实例（包含它的世界存档）"  Padding="13,0" />
				<local:MyButton x:Name="BtnServerFolder" Grid.Column="4" Text="打开文件夹" Height="34" Margin="8,0,0,0" Click="BtnServerFolder_Click"  Padding="13,0" />
				<TextBlock x:Name="LabServerInfo" Grid.Row="1" Grid.ColumnSpan="5" Margin="0,12,0,0" TextWrapping="Wrap" Text="尚未创建任何服务器实例。点击「新建」创建一个专属服务端，它与启动游戏完全独立。" />
				<WrapPanel Grid.Row="2" Grid.ColumnSpan="5" Orientation="Horizontal" Margin="0,12,0,0">
					<local:MyButton x:Name="BtnServerRes" Text="Mod / 插件" Height="32" Margin="0,0,6,0" Click="BtnServerRes_Click" ToolTip="从 Modrinth 下载服务端插件或 Mod，直接装进当前实例的 plugins / mods 文件夹（只安装服务端需要的文件）"  Padding="11,0" />
					<local:MyButton x:Name="BtnServerPack" Text="装整合包" Height="32" Margin="0,0,6,0" Click="BtnServerPack_Click" ToolTip="从 Modrinth 下载服务端整合包，安装成一个独立实例（只下载服务端需要的文件）"  Padding="11,0" />
					<local:MyButton x:Name="BtnServerProps" Text="服务器设置" Height="32" Margin="0,0,6,0" Click="BtnServerProps_Click" ToolTip="图形化修改 server.properties：端口、MOTD、人数上限、正版验证、难度、游戏模式等"  Padding="11,0" />
					<local:MyButton x:Name="BtnServerPlayers" Text="白名单/OP" Height="32" Margin="0,0,6,0" Click="BtnServerPlayers_Click" ToolTip="通过服务器指令管理白名单与 OP（需要服务器正在运行）"  Padding="11,0" />
					<local:MyButton x:Name="BtnServerCrash" Text="崩溃报告" Height="32" Margin="0,0,6,0" Click="BtnServerCrash_Click" ToolTip="打开最新的崩溃报告；没有崩溃报告时打开 latest.log"  Padding="11,0" />
				</WrapPanel>
			</Grid>
		</local:MyCard>
		<local:MyCard Grid.Row="1" Margin="0,0,0,10" Title="服务器控制台">
			<Grid Margin="21,40,21,16">
				<Grid.RowDefinitions>
					<RowDefinition Height="Auto" />
					<RowDefinition Height="*" />
					<RowDefinition Height="Auto" />
				</Grid.RowDefinitions>
				<Grid Grid.Row="0" Margin="0,0,0,10">
					<Grid.ColumnDefinitions>
						<ColumnDefinition Width="Auto" />
						<ColumnDefinition Width="*" />
						<ColumnDefinition Width="Auto" />
						<ColumnDefinition Width="Auto" />
						<ColumnDefinition Width="Auto" />
					</Grid.ColumnDefinitions>
					<Ellipse x:Name="DotServerState" Width="10" Height="10" Fill="#FF9A9A9A" VerticalAlignment="Center" Margin="0,0,8,0" />
					<TextBlock x:Name="LabServerState" Grid.Column="1" Text="未运行" VerticalAlignment="Center" />
					<local:MyButton x:Name="BtnServerStart" Grid.Column="2" Text="启动" Height="32" ColorType="Highlight" Click="BtnServerStart_Click"  Padding="12,0" />
					<local:MyButton x:Name="BtnServerStop" Grid.Column="3" Text="停止" Height="32" Margin="8,0,0,0" Click="BtnServerStop_Click" ToolTip="发送 stop 指令，让服务器保存世界后正常关闭"  Padding="12,0" />
					<local:MyButton x:Name="BtnServerKill" Grid.Column="4" Text="强制结束" Height="32" Margin="8,0,0,0" Click="BtnServerKill_Click" ToolTip="直接结束服务器进程，可能丢失未保存的世界数据"  Padding="12,0" />
				</Grid>
				<Border Grid.Row="1" Background="#FF1E1E1E" CornerRadius="4" Padding="8,6">
					<RichTextBox x:Name="TxtConsole" Background="Transparent" Foreground="#FFDCDCDC" BorderThickness="0" FontFamily="Consolas" FontSize="12" IsReadOnly="True" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" />
				</Border>
				<Grid Grid.Row="2" Margin="0,10,0,0">
					<Grid.ColumnDefinitions>
						<ColumnDefinition Width="*" />
						<ColumnDefinition Width="Auto" />
					</Grid.ColumnDefinitions>
					<local:MyTextBox x:Name="TextCommand" Grid.Column="0" Height="32" HintText="输入服务器指令后回车，例如 list、op 玩家名、say 内容…" KeyDown="TextCommand_KeyDown" ToolTip="与直接在服务器命令行里的输入完全等价" />
					<local:MyButton x:Name="BtnServerSend" Grid.Column="1" Text="发送" Height="32" Margin="8,0,0,0" Click="BtnServerSend_Click"  Padding="12,0" />
				</Grid>
			</Grid>
		</local:MyCard>
		<Border x:Name="PanServerNew" Grid.RowSpan="2" Background="#99000000" Visibility="Collapsed">
			<local:MyCard Width="470" HorizontalAlignment="Center" VerticalAlignment="Center" Title="新建服务器实例">
				<Grid Margin="21,40,21,16">
					<Grid.RowDefinitions>
						<RowDefinition Height="34" />
						<RowDefinition Height="34" />
						<RowDefinition Height="34" />
						<RowDefinition Height="34" />
						<RowDefinition Height="34" />
						<RowDefinition Height="Auto" />
						<RowDefinition Height="44" />
					</Grid.RowDefinitions>
					<Grid.ColumnDefinitions>
						<ColumnDefinition Width="86" />
						<ColumnDefinition Width="*" />
						<ColumnDefinition Width="86" />
						<ColumnDefinition Width="*" />
					</Grid.ColumnDefinitions>
					<TextBlock Text="名称" VerticalAlignment="Center" Margin="0,0,10,0" />
					<local:MyTextBox x:Name="TextNewName" Grid.Column="1" Grid.ColumnSpan="3" Height="30" VerticalAlignment="Center" HintText="例如：我的生存服" />
					<TextBlock Grid.Row="1" Text="游戏版本" VerticalAlignment="Center" Margin="0,0,10,0" />
					<local:MyTextBox x:Name="TextNewVersion" Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="3" Height="30" VerticalAlignment="Center" HintText="例如：1.21.1" TextChanged="TextNewVersion_TextChanged" ToolTip="服务端核心的 Minecraft 版本。下载页里选中的任意版本都会填到这里，也可以手动修改。" />
					<TextBlock Grid.Row="2" Text="服务端类型" VerticalAlignment="Center" Margin="0,0,10,0" />
					<local:MyComboBox x:Name="ComboNewType" Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="3" VerticalAlignment="Center" SelectionChanged="ComboNewType_SelectionChanged" ToolTip="原版：Mojang 官方服务端，只支持数据包&#xA;Paper：优化 + 支持插件（plugins），兼容 Bukkit/Spigot 生态" />
					<TextBlock Grid.Row="3" Text="Java" VerticalAlignment="Center" Margin="0,0,10,0" />
					<local:MyComboBox x:Name="ComboNewJava" Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="3" VerticalAlignment="Center" ToolTip="运行服务端所需的 Java。1.20.5 及以上需要 Java 21，1.18 及以上需要 Java 17。" />
					<TextBlock Grid.Row="4" Text="内存 (MB)" VerticalAlignment="Center" Margin="0,0,10,0" />
					<local:MyTextBox x:Name="TextNewMemory" Grid.Row="4" Grid.Column="1" Height="30" VerticalAlignment="Center" Text="2048" />
					<TextBlock Grid.Row="4" Grid.Column="2" Text="端口" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,10,0" />
					<local:MyTextBox x:Name="TextNewPort" Grid.Row="4" Grid.Column="3" Height="30" VerticalAlignment="Center" Text="25565" />
					<local:MyCheckBox x:Name="CheckNewEula" Grid.Row="5" Grid.ColumnSpan="4" Margin="0,6,0,0" Text="我同意 Minecraft EULA（https://aka.ms/MinecraftEULA）" />
					<StackPanel Grid.Row="6" Grid.ColumnSpan="4" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Bottom">
						<local:MyButton x:Name="BtnNewCancel" Text="取消" Width="86" Height="34" Click="BtnNewCancel_Click"  Padding="13,0" />
						<local:MyButton x:Name="BtnNewCreate" Text="创建并下载" Width="120" Height="34" Margin="10,0,0,0" ColorType="Highlight" Click="BtnNewCreate_Click"  Padding="13,0" />
					</StackPanel>
				</Grid>
			</local:MyCard>
		</Border>
		<Border x:Name="PanServerRes" Grid.RowSpan="2" Background="#99000000" Visibility="Collapsed">
			<local:MyCard Width="740" Height="470" HorizontalAlignment="Center" VerticalAlignment="Center" Title="服务端资源（Modrinth）">
				<Grid Margin="21,40,21,16">
					<Grid.RowDefinitions>
						<RowDefinition Height="Auto" />
						<RowDefinition Height="*" />
						<RowDefinition Height="Auto" />
					</Grid.RowDefinitions>
					<Grid Grid.Row="0">
						<Grid.ColumnDefinitions>
							<ColumnDefinition Width="*" />
							<ColumnDefinition Width="Auto" />
						</Grid.ColumnDefinitions>
						<local:MyTextBox x:Name="TextResSearch" Height="32" HintText="搜索名称，留空查看热门…" KeyDown="TextResSearch_KeyDown" />
						<local:MyButton x:Name="BtnResSearch" Grid.Column="1" Text="搜索" Width="72" Height="32" Margin="8,1,0,1" ColorType="Highlight" Click="BtnResSearch_Click"  Padding="12,0" />
					</Grid>
					<ScrollViewer Grid.Row="1" Margin="0,10,0,0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
						<StackPanel x:Name="PanResList" />
					</ScrollViewer>
					<Grid Grid.Row="2" Margin="0,10,0,0">
						<Grid.ColumnDefinitions>
							<ColumnDefinition Width="*" />
							<ColumnDefinition Width="Auto" />
						</Grid.ColumnDefinitions>
						<TextBlock x:Name="LabResStatus" VerticalAlignment="Center" TextWrapping="Wrap" Text="加载中…" />
						<local:MyButton x:Name="BtnResClose" Grid.Column="1" Text="关闭" Width="80" Height="32" Click="BtnResClose_Click"  Padding="12,0" />
					</Grid>
				</Grid>
			</local:MyCard>
		</Border>
		<Border x:Name="PanServerPack" Grid.RowSpan="2" Background="#99000000" Visibility="Collapsed">
			<local:MyCard Width="760" Height="470" HorizontalAlignment="Center" VerticalAlignment="Center" Title="服务端整合包（Modrinth）">
				<Grid Margin="21,40,21,16">
					<Grid.RowDefinitions>
						<RowDefinition Height="Auto" />
						<RowDefinition Height="*" />
						<RowDefinition Height="Auto" />
					</Grid.RowDefinitions>
					<Grid Grid.Row="0">
						<Grid.ColumnDefinitions>
							<ColumnDefinition Width="*" />
							<ColumnDefinition Width="Auto" />
						</Grid.ColumnDefinitions>
						<local:MyTextBox x:Name="TextPackSearch" Height="32" HintText="搜索整合包（例如 Cobblemon、Create），留空查看热门…" KeyDown="TextPackSearch_KeyDown" />
						<local:MyButton x:Name="BtnPackSearch" Grid.Column="1" Text="搜索" Width="72" Height="32" Margin="8,1,0,1" ColorType="Highlight" Click="BtnPackSearch_Click"  Padding="12,0" />
					</Grid>
					<ScrollViewer Grid.Row="1" Margin="0,10,0,0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
						<StackPanel x:Name="PanPackList" />
					</ScrollViewer>
					<Grid Grid.Row="2" Margin="0,10,0,0">
						<Grid.ColumnDefinitions>
							<ColumnDefinition Width="*" />
							<ColumnDefinition Width="Auto" />
						</Grid.ColumnDefinitions>
						<TextBlock x:Name="LabPackStatus" VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,10,0" Text="安装整合包会新建一个独立实例，只下载服务端需要的文件。" />
						<local:MyButton x:Name="BtnPackClose" Grid.Column="1" Text="关闭" Width="72" Height="32" Click="BtnPackClose_Click"  Padding="12,0" />
					</Grid>
				</Grid>
			</local:MyCard>
		</Border>
		<Border x:Name="PanServerProps" Grid.RowSpan="2" Background="#99000000" Visibility="Collapsed">
			<local:MyCard Width="580" HorizontalAlignment="Center" VerticalAlignment="Center" Title="服务器设置（server.properties）">
				<Grid Margin="21,40,21,16">
					<Grid.RowDefinitions>
						<RowDefinition Height="38" />
						<RowDefinition Height="38" />
						<RowDefinition Height="38" />
						<RowDefinition Height="38" />
						<RowDefinition Height="38" />
						<RowDefinition Height="38" />
						<RowDefinition Height="Auto" />
						<RowDefinition Height="44" />
					</Grid.RowDefinitions>
					<Grid.ColumnDefinitions>
						<ColumnDefinition Width="92" />
						<ColumnDefinition Width="*" />
						<ColumnDefinition Width="92" />
						<ColumnDefinition Width="*" />
					</Grid.ColumnDefinitions>
					<TextBlock Text="MOTD" VerticalAlignment="Center" Margin="0,0,10,0" />
					<local:MyTextBox x:Name="TextPropMotd" Grid.Column="1" Height="28" VerticalAlignment="Center" />
					<TextBlock Grid.Column="2" Text="人数上限" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,10,0" />
					<local:MyTextBox x:Name="TextPropMaxPlayers" Grid.Column="3" Height="28" VerticalAlignment="Center" />
					<TextBlock Grid.Row="1" Text="端口" VerticalAlignment="Center" Margin="0,0,10,0" />
					<local:MyTextBox x:Name="TextPropPort" Grid.Row="1" Grid.Column="1" Height="28" VerticalAlignment="Center" />
					<TextBlock Grid.Row="1" Grid.Column="2" Text="难度" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,10,0" />
					<local:MyComboBox x:Name="ComboPropDifficulty" Grid.Row="1" Grid.Column="3" VerticalAlignment="Center" />
					<TextBlock Grid.Row="2" Text="正版验证" VerticalAlignment="Center" Margin="0,0,10,0" />
					<local:MyComboBox x:Name="ComboPropOnlineMode" Grid.Row="2" Grid.Column="1" VerticalAlignment="Center" ToolTip="开启后只有正版账号可以进入服务器" />
					<TextBlock Grid.Row="2" Grid.Column="2" Text="游戏模式" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,10,0" />
					<local:MyComboBox x:Name="ComboPropGamemode" Grid.Row="2" Grid.Column="3" VerticalAlignment="Center" />
					<TextBlock Grid.Row="3" Text="PvP" VerticalAlignment="Center" Margin="0,0,10,0" />
					<local:MyComboBox x:Name="ComboPropPvp" Grid.Row="3" Grid.Column="1" VerticalAlignment="Center" />
					<TextBlock Grid.Row="3" Grid.Column="2" Text="白名单" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,10,0" />
					<local:MyComboBox x:Name="ComboPropWhitelist" Grid.Row="3" Grid.Column="3" VerticalAlignment="Center" ToolTip="开启后只有白名单中的玩家可以进入（可在「白名单 / OP」里添加）" />
					<TextBlock Grid.Row="4" Text="视距" VerticalAlignment="Center" Margin="0,0,10,0" />
					<local:MyTextBox x:Name="TextPropViewDistance" Grid.Row="4" Grid.Column="1" Height="28" VerticalAlignment="Center" />
					<TextBlock Grid.Row="4" Grid.Column="2" Text="模拟距离" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,10,0" />
					<local:MyTextBox x:Name="TextPropSimDistance" Grid.Row="4" Grid.Column="3" Height="28" VerticalAlignment="Center" />
					<TextBlock Grid.Row="5" Text="出生点保护" VerticalAlignment="Center" Margin="0,0,10,0" />
					<local:MyTextBox x:Name="TextPropSpawnProtection" Grid.Row="5" Grid.Column="1" Height="28" VerticalAlignment="Center" ToolTip="出生点周围无法被破坏的方块半径" />
					<TextBlock Grid.Row="5" Grid.Column="2" Text="监听地址" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,10,0" />
					<local:MyTextBox x:Name="TextPropServerIp" Grid.Row="5" Grid.Column="3" Height="28" VerticalAlignment="Center" ToolTip="留空表示监听所有地址" />
					<TextBlock x:Name="LabPropsHint" Grid.Row="6" Grid.ColumnSpan="4" TextWrapping="Wrap" Margin="0,6,0,0" Text="修改会在下次启动服务器时生效；服务器运行中修改需要重启。" />
					<StackPanel Grid.Row="7" Grid.ColumnSpan="4" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Bottom">
						<local:MyButton x:Name="BtnPropsClose" Text="取消" Width="86" Height="32" Click="BtnPropsClose_Click" />
						<local:MyButton x:Name="BtnPropsSave" Text="保存" Width="100" Height="32" Margin="10,0,0,0" ColorType="Highlight" Click="BtnPropsSave_Click" />
					</StackPanel>
				</Grid>
			</local:MyCard>
		</Border>
		<Border x:Name="PanServerPlayers" Grid.RowSpan="2" Background="#99000000" Visibility="Collapsed">
			<local:MyCard Width="540" HorizontalAlignment="Center" VerticalAlignment="Center" Title="白名单 / OP">
				<Grid Margin="21,40,21,16">
					<Grid.RowDefinitions>
						<RowDefinition Height="38" />
						<RowDefinition Height="Auto" />
						<RowDefinition Height="Auto" />
						<RowDefinition Height="44" />
					</Grid.RowDefinitions>
					<Grid.ColumnDefinitions>
						<ColumnDefinition Width="86" />
						<ColumnDefinition Width="*" />
					</Grid.ColumnDefinitions>
					<TextBlock Text="玩家名" VerticalAlignment="Center" Margin="0,0,10,0" />
					<local:MyTextBox x:Name="TextPlayerName" Grid.Column="1" Height="30" VerticalAlignment="Center" HintText="请输入玩家的正版 ID" />
					<WrapPanel Grid.Row="1" Grid.ColumnSpan="2" Margin="0,10,0,0">
						<local:MyButton x:Name="BtnPlayerWhitelistAdd" Text="加入白名单" Height="34" Margin="0,0,8,8" Click="BtnPlayerWhitelistAdd_Click"  Padding="13,0" />
						<local:MyButton x:Name="BtnPlayerWhitelistRemove" Text="移出白名单" Height="34" Margin="0,0,8,8" Click="BtnPlayerWhitelistRemove_Click"  Padding="13,0" />
						<local:MyButton x:Name="BtnPlayerOp" Text="设为 OP" Height="34" Margin="0,0,8,8" Click="BtnPlayerOp_Click"  Padding="13,0" />
						<local:MyButton x:Name="BtnPlayerDeOp" Text="取消 OP" Height="34" Margin="0,0,8,8" Click="BtnPlayerDeOp_Click"  Padding="13,0" />
					</WrapPanel>
					<TextBlock x:Name="LabPlayersStatus" Grid.Row="2" Grid.ColumnSpan="2" TextWrapping="Wrap" Margin="0,6,0,0" Text="这些操作会以服务器指令的形式发送，需要服务器正在运行。" />
					<local:MyButton x:Name="BtnPlayersClose" Grid.Row="3" Grid.ColumnSpan="2" Text="关闭" Width="86" Height="32" HorizontalAlignment="Right" VerticalAlignment="Bottom" Click="BtnPlayersClose_Click" />
				</Grid>
			</local:MyCard>
		</Border>
	</Grid>
</local:MyPageRight>